[Option]
CC_LOC=$(APPDIR)\toolchain\udocc
CC_FLAG_D=-S -gstabs -Wall -mnonb_data -mglobal-var-ram -mISA=2.0
CC_FLAG_R=-S -O1 -Wall -mglobal-var-ram -mISA=2.0

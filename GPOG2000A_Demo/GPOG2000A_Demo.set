AS_FLAG_D=-t4 -d -sr -Wno-A2013
AS_FLAG_R=-t4 -sr
LD_LOC=$(APPDIR)\toolchain\xlink16_GPCE3
LD_FLAG_D=-Wno-L0062 -Wno-L0064 -Wno-L0066 -blank 0x00
LD_FLAG_R=-Wno-L0062 -blank 0x00
